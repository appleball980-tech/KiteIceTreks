# Copy to .env.local for local development.

# Backend API base URL (see /backend). Used by the server to fetch page data
# and by the browser for the enquiry form, so it must be publicly reachable in production.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: a private/internal URL the Next.js server should use instead (e.g. same VPC)
# API_URL=http://127.0.0.1:4000/api/v1

# Your real domain, used for canonical URLs, sitemap and structured data
# NEXT_PUBLIC_SITE_URL=https://www.kiteicetreks.com

# Shared secret the backend uses to refresh pages after admin edits.
# Must match REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=
