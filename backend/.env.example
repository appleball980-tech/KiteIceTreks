# Copy to .env and fill in real values.

# MySQL 8+ connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/kiteice"
# Max open DB connections per API process
DB_POOL_SIZE=10

NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS="http://localhost:3000"

# How long (seconds) public GET responses are cached in memory and by CDNs/browsers
CACHE_TTL_SECONDS=300

# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Render, Railway…)
# so rate limiting and logging see the real client IP.
TRUST_PROXY=0

# ---------- Admin login ----------
# Long random secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# How long a login lasts (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# ---------- Instant website updates ----------
# After an admin edit, the API tells the website to refresh its cached pages.
# Must match REVALIDATE_SECRET in the website's env.
SITE_URL="http://localhost:3000"
REVALIDATE_SECRET=""

# ---------- Image uploads ----------
# Folder for uploaded images (use a persistent disk/volume in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# External image hosts admins may link to instead of uploading (comma-separated).
# Each must also be allowed in the website's next.config.mjs images.remotePatterns.
IMAGE_HOSTS=images.unsplash.com
